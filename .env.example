# ==============================================================================
# RailTrack — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your confidential credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Île-de-France Mobilités (PRIM) Real-Time API Key
# Request your free key at: https://prim.iledefrance-mobilites.fr/
PRIM_API_KEY=your_prim_api_key_here

# Airflow Core Cryptography Key (Fernet Key)
# Encrypts passwords and connection credentials in the Postgres metastore at rest.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_generated_fernet_key_here

# Airflow Webserver Session Signing Key (Flask Secret Key)
# Signs session cookies to prevent CSRF and session tampering.
AIRFLOW__WEBSERVER__SECRET_KEY=your_random_secret_key_here

# Airflow Webserver Initial Admin Password
_AIRFLOW_WWW_USER_PASSWORD=admin

# Host User ID for Volume Mounts (defaults to 1000 on Linux: `id -u`)
AIRFLOW_UID=1000
